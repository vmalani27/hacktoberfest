# LLM Provider Configuration ("bedrock" or "openai")
LLM_PROVIDER=bedrock

# Amazon Bedrock Configuration (Uses active AWS CLI credentials)
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=apac.amazon.nova-pro-v1:0

# OpenAI-Compatible Configuration (Optional alternative)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-flash-latest

# Backend Service Config
HOST=0.0.0.0
PORT=8000
DEBUG=True
WORKSPACE_DIR=./workspace

# Execution & Safety Guardrails
COMMAND_TIMEOUT_SECONDS=120
MAX_STEP_LIMIT=25
MAX_RETRY_LIMIT=3
